# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ---- Credit Service -----------------------------------------
# App
CREDIT_SERVICE_PORT=3000

# Postgres (see credit-service/docker-compose.yml)
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
POSTGRES_DB=credit_db
CREDIT_DB_PORT=5432

# Connection string used by the service (defaults to the compose Postgres above)
DATABASE_URL=postgres://credit:credit@localhost:5432/credit_db

# ---- Kafka (event flows) ------------------------------------
# user-service publishes the `UserVerified` event; credit-service consumes it to
# onboard the user, and settles order-service's foc.credit.commands. In the
# cluster the Helm chart injects these per service (see
# deploy/charts/foc-service); leave KAFKA_BROKERS empty locally to disable
# Kafka — the producer logs instead of sending and the consumers do not start.
# KAFKA_CA_CERT is a FILE PATH to Strimzi's PEM CA, not the certificate text.
KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_CA_CERT=
# Optional overrides (defaults shown):
# KAFKA_USER_STATUS_TOPIC=foc.user.status
# KAFKA_CREDIT_COMMANDS_TOPIC=foc.credit.commands     # credit-service only
# Consumer groups, credit-service only; must start with "credit":
# KAFKA_USER_STATUS_GROUP_ID=credit-user-status
# KAFKA_CREDIT_COMMANDS_GROUP_ID=credit-commands

# ... Add more variables as needed

# ---- Rating Service -----------------------------------------
# rating-service reads its own .env; these mirror its defaults.
RATING_SERVICE_PORT=8085

# Postgres (see rating-service/docker-compose.yml; host port 5433 so it can run beside credit)
RATING_DB_PORT=5433
# DATABASE_URL=postgres://rating:rating@localhost:5433/rating_db

# ---- Order service (dev profile) ----------------------------
# Compose reads these from order-service/.env, not from this file.
# Copy order-service/.env.example to order-service/.env.
ORDER_DB_URL=
ORDER_DB_USERNAME=
ORDER_DB_PASSWORD=
ORDER_KAFKA_BOOTSTRAP_SERVERS=
ORDER_PHOTOS_ENDPOINT=
ORDER_PHOTOS_BUCKET=
ORDER_PHOTOS_REGION=
ORDER_PHOTOS_ACCESS_KEY=
ORDER_PHOTOS_SECRET_KEY=
ORDER_PHOTOS_PATH_STYLE=

# ---- Order service (k8s profile) ----------------------------
# In the cluster (SPRING_PROFILES_ACTIVE=k8s) the Helm chart injects these from
# Secret order-db, plus the KAFKA_* variables above; see
# deploy/values/services/order.yaml. Never set by hand, so commented out (in a
# sourced shell they would also redirect psql).
# PGHOST=
# PGPORT=
# PGDATABASE=
# PGUSER=
# PGPASSWORD=
# PGSSLMODE=require
