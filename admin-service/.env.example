# Copy to .env for host-side tools (alembic, pytest, local uvicorn).
# Hostname "db" / "kafka" only work *inside* the Compose network.
# From Windows PowerShell you must use localhost and the mapped ports.
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5434/admin_service
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
USER_SERVICE_BASE_URL=http://localhost:8090
ORDER_SERVICE_BASE_URL=http://order-service:8000
AI_PROVIDER_BASE_URL=https://api.anthropic.com
AI_PROVIDER_API_KEY=
RESOLUTION_DEADLINE_HOURS=168
REMINDER_BEFORE_DEADLINE_HOURS=24
