# Copy to .env for host-side tools (alembic, pytest, local uvicorn).
# Hostname "db" only works inside this Compose network.
# Kafka is Order's broker (order-service/compose.yaml). Do not start another.
# From the host that broker is localhost:9092. The admin container uses
# kafka:29092 on Order's network instead, set in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5434/admin_service
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
USER_SERVICE_BASE_URL=http://localhost:8090
ORDER_SERVICE_BASE_URL=http://localhost:8083
# Order's MinIO, published on the host as 9100. Kubernetes leaves the endpoint
# and keys empty and uses the node role against ORDER_PHOTOS_BUCKET.
ORDER_PHOTOS_ENDPOINT=http://localhost:9100
ORDER_PHOTOS_BUCKET=order-photos
ORDER_PHOTOS_REGION=us-east-1
ORDER_PHOTOS_ACCESS_KEY=order
ORDER_PHOTOS_SECRET_KEY=orderorder
ORDER_PHOTOS_PATH_STYLE=true
# Google AI Studio key. 2.5 Flash is closed to new keys; 3.8 Flash is the current model.
AI_PROVIDER_BASE_URL=https://generativelanguage.googleapis.com
AI_MODEL=gemini-3.8-flash
AI_PROVIDER_API_KEY=
AI_CALL_TIMEOUT_SECONDS=60
RESOLUTION_DEADLINE_HOURS=168
REMINDER_BEFORE_DEADLINE_HOURS=24
