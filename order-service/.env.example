# Copy to .env in this directory. Compose reads .env from here.
# .env is git-ignored. Do not commit real secrets.
#
# These values match the local Compose stack (Postgres, Kafka, MinIO).
# Change them when the dev profile points at another database, broker, or photo store.

ORDER_DB_URL=jdbc:postgresql://order-db:5432/order
ORDER_DB_USERNAME=order
ORDER_DB_PASSWORD=order
ORDER_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
ORDER_PHOTOS_ENDPOINT=http://minio:9000
ORDER_PHOTOS_BUCKET=order-photos
ORDER_PHOTOS_REGION=us-east-1
ORDER_PHOTOS_ACCESS_KEY=order
ORDER_PHOTOS_SECRET_KEY=orderorder
# true: bucket is in the URL path (required by MinIO). false: bucket is the hostname (typical AWS S3).
ORDER_PHOTOS_PATH_STYLE=true
