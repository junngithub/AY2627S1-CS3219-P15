# Local-only SonarQube server. Not deployed.
# The application image is Dockerfile. This image does not contain the app.
# JDBC settings are supplied by compose.local.yaml.
FROM sonarqube:26.9.0.129388-community
USER sonarqube
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=10 \
  CMD ["curl", "-fsS", "http://127.0.0.1:9000/api/system/status"]
