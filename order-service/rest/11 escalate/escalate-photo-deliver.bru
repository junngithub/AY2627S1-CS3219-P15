meta {
  name: Deliver dispute photo
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/deliver
  body: multipart-form
  auth: none
}
headers {
  X-User-Id: esc-photo-courier@u.nus.edu
  X-User-Email: esc-photo-courier@u.nus.edu
  X-User-Telegram: esc-photo-courier
}



body:multipart-form {
  photo: @file(../fixtures/proof.png)
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("DELIVERED");
  });
}
