meta {
  name: Escalate a delivered order
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/escalate
  body: json
  auth: none
}
headers {
  X-User-Id: esc-del-req@u.nus.edu
  X-User-Email: esc-del-req@u.nus.edu
  X-User-Telegram: esc-del-req
}



body:json {
  {
    "disputeText": "The courier collected the wrong item"
  }
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ESCALATED");
  });
}

