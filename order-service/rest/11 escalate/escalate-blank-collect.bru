meta {
  name: Collect blank dispute
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/collect
  body: multipart-form
  auth: none
}
headers {
  X-User-Id: esc-blank-courier@u.nus.edu
  X-User-Email: esc-blank-courier@u.nus.edu
  X-User-Telegram: esc-blank-courier
}



body:multipart-form {
  photo: @file(../fixtures/proof.png)
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("COLLECTED");
  });
}

