meta {
  name: Collect dispute photo
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/collect
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: stub:esc-photo-courier@u.nus.edu
}

body:multipart-form {
  photo: @file(../fixtures/proof.png)
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("COLLECTED");
  });
}
