meta {
  name: Courier cannot escalate
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/escalate
  body: json
  auth: bearer
}

auth:bearer {
  token: stub:esc-notreq-courier@u.nus.edu
}

body:json {
  {
    "disputeText": "The courier collected the wrong item"
  }
}

tests {
  test("status is 409", function() {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().error).to.include("Only the requester");
  });
}

