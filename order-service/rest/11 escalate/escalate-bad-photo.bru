meta {
  name: Dispute photo is not an image
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/escalate
  body: multipart-form
  auth: none
}
headers {
  X-User-Id: 003a6e28-b037-30d0-8622-b9e279d01823
  X-User-Telegram: esc-badphoto-req
}



body:multipart-form {
  disputeText: The courier delivered the wrong item
  photo: @file(../fixtures/notes.txt)
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("JPEG, PNG, or WebP");
  });
}
