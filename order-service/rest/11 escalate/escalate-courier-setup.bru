meta {
  name: Setup courier dispute
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}
headers {
  X-User-Id: bfe5e62b-c890-3afa-88f7-a312905397b1
  X-User-Telegram: esc-notreq-req
}



body:json {
  {
    "itemDescription": "Print notes",
    "credits": 1,
    "expiryTime": "{{acceptanceExpiry}}",
    "deliveryTime": "{{deliveryDeadline}}",
    "fromLocation": "2",
    "toLocation": "4"
  }
}

script:post-response {
  bru.setVar("orderId", res.getBody().id);
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("CREATED");
  });
}

