meta {
  name: Deliver dispute order
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/deliver
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: stub:esc-del-courier@u.nus.edu
}

body:multipart-form {
  photo: @file(../fixtures/proof.png)
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("DELIVERED");
  });
}

