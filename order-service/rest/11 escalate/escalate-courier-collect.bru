meta {
  name: Collect courier dispute
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/collect
  body: multipart-form
  auth: none
}
headers {
  X-User-Id: ba7dba89-fdf3-3780-ac38-2bcf64aef3bf
  X-User-Telegram: esc-notreq-courier
}



body:multipart-form {
  photo: @file(../fixtures/proof.png)
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("COLLECTED");
  });
}

