meta {
  name: Accept dispute photo
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/accept
  body: none
  auth: none
}
headers {
  X-User-Id: esc-photo-courier@u.nus.edu
  X-User-Email: esc-photo-courier@u.nus.edu
  X-User-Telegram: esc-photo-courier
}



tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ACCEPTED");
  });
}
