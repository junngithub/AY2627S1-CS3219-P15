meta {
  name: Dispute text over 2000 characters
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/escalate
  body: json
  auth: none
}
headers {
  X-User-Id: esc-blank-req@u.nus.edu
  X-User-Email: esc-blank-req@u.nus.edu
  X-User-Telegram: esc-blank-req
}



body:json {
  {
    "disputeText": "{{longDispute}}"
  }
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("disputeText");
  });
}

