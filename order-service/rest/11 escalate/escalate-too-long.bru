meta {
  name: Dispute text over 2000 characters
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/escalate
  body: json
  auth: bearer
}

auth:bearer {
  token: stub:esc-blank-req@u.nus.edu
}

body:json {
  {
    "disputeText": "{{longDispute}}"
  }
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("disputeText");
  });
}

