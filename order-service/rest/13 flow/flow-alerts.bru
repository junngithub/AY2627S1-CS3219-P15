meta {
  name: Alerts
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/orders/alerts
  body: none
  auth: none
}
headers {
  X-User-Id: flow-req@u.nus.edu
  X-User-Email: flow-req@u.nus.edu
  X-User-Telegram: flow-req
}



tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().content.length).to.be.at.least(1);
  });
}

