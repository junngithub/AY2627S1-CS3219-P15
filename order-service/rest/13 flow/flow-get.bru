meta {
  name: Get
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}
  body: none
  auth: none
}
headers {
  X-User-Id: flow-req@u.nus.edu
  X-User-Email: flow-req@u.nus.edu
  X-User-Telegram: flow-req
}



tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("CREATED");
  });
}

