meta {
  name: Collect with a photo
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/collect
  body: multipartForm
  auth: none
}
headers {
  X-User-Id: collect-courier@u.nus.edu
  X-User-Email: collect-courier@u.nus.edu
  X-User-Telegram: collect-courier
}



body:multipart-form {
  photo: @file(C:\Users\varun\Pictures\Screenshots\Screenshot 2023-07-26 180036.png) @contentType(image/png)
}

body:file {
  file: @file(C:\Users\varun\Pictures\Screenshots\Screenshot 2023-08-01 094225.png) @contentType(image/png)
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("COLLECTED");
  });
}
