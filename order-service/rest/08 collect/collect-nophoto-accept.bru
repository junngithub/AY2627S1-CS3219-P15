meta {
  name: Accept missing photo
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/accept
  body: none
  auth: none
}
headers {
  X-User-Id: collect-nophoto-courier@u.nus.edu
  X-User-Email: collect-nophoto-courier@u.nus.edu
  X-User-Telegram: collect-nophoto-courier
}



tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ACCEPTED");
  });
}

