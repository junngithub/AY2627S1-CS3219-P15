meta {
  name: Accept bad photo type
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/accept
  body: none
  auth: none
}
headers {
  X-User-Id: collect-type-courier@u.nus.edu
  X-User-Email: collect-type-courier@u.nus.edu
  X-User-Telegram: collect-type-courier
}



tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ACCEPTED");
  });
}

