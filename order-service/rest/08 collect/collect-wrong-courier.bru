meta {
  name: Another courier collects
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/collect
  body: multipartForm
  auth: none
}
headers {
  X-User-Id: collect-stranger@u.nus.edu
  X-User-Email: collect-stranger@u.nus.edu
  X-User-Telegram: collect-stranger
}



body:multipart-form {
  photo: @file(C:\Users\varun\Pictures\Screenshots\Screenshot 2023-07-26 180036.png) @contentType(image/png)
}

tests {
  test("status is 409", function() {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().error).to.include("assigned courier");
  });
}
