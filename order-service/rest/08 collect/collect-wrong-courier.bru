meta {
  name: Another courier collects
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/collect
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: stub:collect-stranger@u.nus.edu
}

body:multipart-form {
  photo: @file(../fixtures/proof.png)
}

tests {
  test("status is 409", function() {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().error).to.include("assigned courier");
  });
}

