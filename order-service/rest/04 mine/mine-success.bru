meta {
  name: List my orders
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/orders/mine
  body: none
  auth: none
}
headers {
  X-User-Id: mine-req@u.nus.edu
  X-User-Email: mine-req@u.nus.edu
  X-User-Telegram: mine-req
}



tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().content.length).to.be.at.least(1);
  });
}

