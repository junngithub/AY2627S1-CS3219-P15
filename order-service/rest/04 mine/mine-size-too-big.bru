meta {
  name: Page size over 1000
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/orders/mine?size=1001
  body: none
  auth: none
}
headers {
  X-User-Id: mine-req@u.nus.edu
  X-User-Email: mine-req@u.nus.edu
  X-User-Telegram: mine-req
}



tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("Page size");
  });
}

