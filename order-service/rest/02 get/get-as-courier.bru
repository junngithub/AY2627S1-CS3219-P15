meta {
  name: Get as assigned courier
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}
  body: none
  auth: none
}
headers {
  X-User-Id: get-courier@u.nus.edu
  X-User-Email: get-courier@u.nus.edu
  X-User-Telegram: get-courier
}



tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ACCEPTED");
  });
}

