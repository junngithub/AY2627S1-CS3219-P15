meta {
  name: Unknown dropoff
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/orders/search?dropoffLocationId=nowhere
  body: none
  auth: none
}
headers {
  X-User-Id: search-courier@u.nus.edu
  X-User-Email: search-courier@u.nus.edu
  X-User-Telegram: search-courier
}



tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("approved supplier");
  });
}

