meta {
  name: Search by pickup
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/orders/search?pickupLocationId=nus-coop
  body: none
  auth: none
}
headers {
  X-User-Id: search-courier@u.nus.edu
  X-User-Email: search-courier@u.nus.edu
  X-User-Telegram: search-courier
}



tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().content.length).to.be.at.least(1);
  });
}

