meta {
  name: Requester cannot cancel after accept
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/cancel
  body: none
  auth: none
}
headers {
  X-User-Id: cancel-late-req@u.nus.edu
  X-User-Email: cancel-late-req@u.nus.edu
  X-User-Telegram: cancel-late-req
}



tests {
  test("status is 409", function() {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().error).to.include("cannot be cancelled");
  });
}

