meta {
  name: Someone else cannot cancel
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/cancel
  body: none
  auth: none
}
headers {
  X-User-Id: cancel-outsider@u.nus.edu
  X-User-Email: cancel-outsider@u.nus.edu
  X-User-Telegram: cancel-outsider
}



tests {
  test("status is 409", function() {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().error).to.include("cannot be cancelled");
  });
}

