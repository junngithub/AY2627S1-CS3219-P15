meta {
  name: Requester cancels an open order
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/cancel
  body: none
  auth: none
}
headers {
  X-User-Id: cancel-req@u.nus.edu
  X-User-Email: cancel-req@u.nus.edu
  X-User-Telegram: cancel-req
}



tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("CANCELLED");
  });
}

