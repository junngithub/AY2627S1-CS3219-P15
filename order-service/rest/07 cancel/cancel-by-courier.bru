meta {
  name: Courier returns an accepted order to the pool
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/cancel
  body: none
  auth: bearer
}

auth:bearer {
  token: stub:cancel-back-courier@u.nus.edu
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("CREATED");
  });
}

