meta {
  name: Unknown dropoff location
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}
headers {
  X-User-Id: create-baddrop@u.nus.edu
  X-User-Email: create-baddrop@u.nus.edu
  X-User-Telegram: create-baddrop
}



body:json {
  {
    "itemDescription": "Print notes",
    "credits": 1,
    "expiryTime": "{{acceptanceExpiry}}",
    "deliveryTime": "{{deliveryDeadline}}",
    "fromLocation": "nus-coop",
    "toLocation": "nowhere"
  }
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("approved supplier");
  });
}

