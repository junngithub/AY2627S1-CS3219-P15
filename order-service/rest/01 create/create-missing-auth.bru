meta {
  name: create missing auth
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}

body:json {
  {
    "itemDescription": "Print notes",
    "credits": 1,
    "expiryTime": "{{acceptanceExpiry}}",
    "deliveryTime": "{{deliveryDeadline}}",
    "fromLocation": "nus-coop",
    "toLocation": "cool-spot"
  }
}

tests {
  test("status is 401", function() {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error).to.include("Sign in is required");
  });
}

