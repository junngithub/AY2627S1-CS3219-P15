meta {
  name: Negative amount
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}
headers {
  X-User-Id: create-neg@u.nus.edu
  X-User-Email: create-neg@u.nus.edu
  X-User-Telegram: create-neg
}



body:json {
  {
    "itemDescription": "Print notes",
    "credits": -3,
    "expiryTime": "{{acceptanceExpiry}}",
    "deliveryTime": "{{deliveryDeadline}}",
    "fromLocation": "nus-coop",
    "toLocation": "cool-spot"
  }
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("credits");
  });
}

