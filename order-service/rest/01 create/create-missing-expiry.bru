meta {
  name: Missing acceptance expiry
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}
headers {
  X-User-Id: 200815eb-eb6f-3f2d-a233-96430eb4adaf
  X-User-Telegram: create-noexp
}



body:json {
  {
    "itemDescription": "Print notes",
    "credits": 1,
    "deliveryTime": "{{deliveryDeadline}}",
    "fromLocation": "2",
    "toLocation": "4"
  }
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("expiryTime");
  });
}

