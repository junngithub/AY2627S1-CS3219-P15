meta {
  name: Missing delivery deadline
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}
headers {
  X-User-Id: create-nodel@u.nus.edu
  X-User-Email: create-nodel@u.nus.edu
  X-User-Telegram: create-nodel
}



body:json {
  {
    "itemDescription": "Print notes",
    "credits": 1,
    "expiryTime": "{{acceptanceExpiry}}",
    "fromLocation": "nus-coop",
    "toLocation": "cool-spot"
  }
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("deliveryTime");
  });
}

