meta {
  name: Reward above the credit balance
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: stub:create-broke@u.nus.edu
}

body:json {
  {
    "itemDescription": "Print notes",
    "credits": 21,
    "expiryTime": "{{acceptanceExpiry}}",
    "deliveryTime": "{{deliveryDeadline}}",
    "fromLocation": "nus-coop",
    "toLocation": "cool-spot"
  }
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("Not enough credits");
  });
}

