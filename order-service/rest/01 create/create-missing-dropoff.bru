meta {
  name: Missing dropoff location
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}
headers {
  X-User-Id: create-nodrop@u.nus.edu
  X-User-Email: create-nodrop@u.nus.edu
  X-User-Telegram: create-nodrop
}



body:json {
  {
    "itemDescription": "Print notes",
    "credits": 1,
    "expiryTime": "{{acceptanceExpiry}}",
    "deliveryTime": "{{deliveryDeadline}}",
    "fromLocation": "nus-coop"
  }
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("toLocation");
  });
}

