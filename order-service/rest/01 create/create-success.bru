meta {
  name: Create order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}
headers {
  X-User-Id: create-ok@u.nus.edu
  X-User-Email: create-ok@u.nus.edu
  X-User-Telegram: create-ok
}



body:json {
  {
    "itemDescription": "Print notes",
    "credits": 1,
    "expiryTime": "{{acceptanceExpiry}}",
    "deliveryTime": "{{deliveryDeadline}}",
    "fromLocation": "nus-coop",
    "toLocation": "cool-spot"
  }
}

vars:pre-request {
  acceptanceExpiry: 2026-09-30T00:00:00Z
  deliveryDeadline: 2026-09-31T00:00:00Z
}

script:post-response {
  bru.setVar("orderId", res.getBody().id);
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("CREATED");
  });
}
