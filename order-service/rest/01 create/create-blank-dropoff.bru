}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}
headers {
  X-User-Id: 98d95b7f-be46-3a0c-ba04-694dbd15b87f
  X-User-Telegram: create-blankdrop
}



body:json {
  {
    "itemDescription": "Print notes",
    "credits": 1,
    "expiryTime": "{{acceptanceExpiry}}",
    "deliveryTime": "{{deliveryDeadline}}",
    "fromLocation": "2",
    "toLocation": ""
  }
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("toLocation");
  });
}

