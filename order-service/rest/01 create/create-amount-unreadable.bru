meta {
  name: Amount is not a number
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}
headers {
  X-User-Id: create-nan@u.nus.edu
  X-User-Email: create-nan@u.nus.edu
  X-User-Telegram: create-nan
}



body:json {
  {
    "itemDescription": "Print notes",
    "credits": "abc",
    "expiryTime": "{{acceptanceExpiry}}",
    "deliveryTime": "{{deliveryDeadline}}",
    "fromLocation": "nus-coop",
    "toLocation": "cool-spot"
  }
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("could not be read");
  });
}

