meta {
  name: Collect courier acknowledge
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/collect
  body: multipart-form
  auth: none
}
headers {
  X-User-Id: c90c3b6d-a0c3-3dea-b640-87c23b1ca59d
  X-User-Telegram: ack-notreq-courier
}



body:multipart-form {
  photo: @file(../fixtures/proof.png)
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("COLLECTED");
  });
}

