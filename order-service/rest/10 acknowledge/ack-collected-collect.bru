meta {
  name: Collect order
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/collect
  body: multipart-form
  auth: none
}
headers {
  X-User-Id: 8bcb9fdb-8eba-3aa5-8a88-d5e598bdabc2
  X-User-Telegram: ack-collected-courier
}



body:multipart-form {
  photo: @file(../fixtures/proof.png)
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("COLLECTED");
  });
}

