meta {
  name: Setup courier acknowledge
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}
headers {
  X-User-Id: c772e1d8-ce09-3959-9069-35e956c2b3b1
  X-User-Telegram: ack-notreq-req
}



body:json {
  {
    "itemDescription": "Print notes",
    "credits": 1,
    "expiryTime": "{{acceptanceExpiry}}",
    "deliveryTime": "{{deliveryDeadline}}",
    "fromLocation": "2",
    "toLocation": "4"
  }
}

script:post-response {
  bru.setVar("orderId", res.getBody().id);
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("CREATED");
  });
}

