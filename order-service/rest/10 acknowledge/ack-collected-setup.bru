meta {
  name: Setup collected order
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}
headers {
  X-User-Id: 6c7e8b91-a6e0-3806-8099-c1a0d2c6a0fc
  X-User-Telegram: ack-collected-req
}



body:json {
  {
    "itemDescription": "Print notes",
    "credits": 1,
    "expiryTime": "{{acceptanceExpiry}}",
    "deliveryTime": "{{deliveryDeadline}}",
    "fromLocation": "2",
    "toLocation": "4"
  }
}

script:post-response {
  bru.setVar("orderId", res.getBody().id);
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("CREATED");
  });
}

