meta {
  name: Accept missing photo
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/accept
  body: multipartForm
  auth: none
}
headers {
  X-User-Id: deliver-nophoto-courier@u.nus.edu
  X-User-Email: deliver-nophoto-courier@u.nus.edu
  X-User-Telegram: deliver-nophoto-courier
}



body:multipart-form {
  : @file(C:\Users\varun\Downloads\My Timetable (5).png) @contentType(image/png)
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ACCEPTED");
  });
}
