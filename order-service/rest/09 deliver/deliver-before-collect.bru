meta {
  name: Deliver before collect
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/deliver
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: stub:deliver-courier@u.nus.edu
}

body:multipart-form {
  photo: @file(../fixtures/proof.png)
}

tests {
  test("status is 409", function() {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().error).to.include("has not been collected");
  });
}

