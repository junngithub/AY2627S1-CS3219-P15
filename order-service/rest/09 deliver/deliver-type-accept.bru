meta {
  name: Accept bad photo type
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/accept
  body: none
  auth: none
}
headers {
  X-User-Id: deliver-type-courier@u.nus.edu
  X-User-Email: deliver-type-courier@u.nus.edu
  X-User-Telegram: deliver-type-courier
}



tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ACCEPTED");
  });
}

