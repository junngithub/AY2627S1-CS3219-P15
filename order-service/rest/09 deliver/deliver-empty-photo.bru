meta {
  name: Empty photo
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/deliver
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: stub:deliver-empty-courier@u.nus.edu
}

body:multipart-form {
  photo: @file(../fixtures/empty.png)
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("photo is required");
  });
}

