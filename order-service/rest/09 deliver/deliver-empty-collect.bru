meta {
  name: Collect empty photo
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/collect
  body: multipart-form
  auth: none
}
headers {
  X-User-Id: 5990f59f-83d1-3d7b-8a36-ab852cea17f4
  X-User-Telegram: deliver-empty-courier
}



body:multipart-form {
  photo: @file(../fixtures/proof.png)
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("COLLECTED");
  });
}

