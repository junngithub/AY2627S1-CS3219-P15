meta {
  name: Setup open order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}
headers {
  X-User-Id: 51782dc4-c45c-3ffb-9c44-49c89589d31e
  X-User-Telegram: accept-req
}



body:json {
  {
    "itemDescription": "Print notes",
    "credits": 1,
    "expiryTime": "{{acceptanceExpiry}}",
    "deliveryTime": "{{deliveryDeadline}}",
    "fromLocation": "2",
    "toLocation": "4"
  }
}

script:post-response {
  bru.setVar("orderId", res.getBody().id);
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("CREATED");
  });
}

