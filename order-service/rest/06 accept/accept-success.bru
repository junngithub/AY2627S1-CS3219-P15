meta {
  name: Accept order
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}/accept
  body: none
  auth: none
}
headers {
  X-User-Id: accept-courier@u.nus.edu
  X-User-Email: accept-courier@u.nus.edu
  X-User-Telegram: accept-courier
}



tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("ACCEPTED");
  });
}

