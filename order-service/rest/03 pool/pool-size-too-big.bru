meta {
  name: Page size over 1000
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/orders?size=1001
  body: none
  auth: none
}
headers {
  X-User-Id: pool-courier@u.nus.edu
  X-User-Email: pool-courier@u.nus.edu
  X-User-Telegram: pool-courier
}



tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("Page size");
  });
}

