meta {
  name: Pool ranked by proximity
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/orders?latitude=1.2968&longitude=103.7733&page=0&size=20
  body: none
  auth: none
}
headers {
  X-User-Id: pool-courier@u.nus.edu
  X-User-Email: pool-courier@u.nus.edu
  X-User-Telegram: pool-courier
}



tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().content.length).to.be.at.least(1);
  });
}

