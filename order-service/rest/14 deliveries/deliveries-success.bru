meta {
  name: List completed deliveries
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/orders/deliveries/past
  body: none
  auth: none
}
headers {
  X-User-Id: c35dc8b4-f300-3285-8e2f-983ed1c791ef
  X-Permitted-Action: true
  X-User-Telegram: deliver-courier
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    const match = res.getBody().content.find(order => order.id === bru.getVar("orderId"));
    expect(match.status).to.equal("DELIVERED");
    expect(match.courierId).to.equal("c35dc8b4-f300-3285-8e2f-983ed1c791ef");
  });
}
