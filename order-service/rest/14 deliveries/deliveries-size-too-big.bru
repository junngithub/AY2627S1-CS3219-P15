meta {
  name: Page size over 1000
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/orders/deliveries?size=1001
  body: none
  auth: none
}
headers {
  X-User-Id: c35dc8b4-f300-3285-8e2f-983ed1c791ef
  X-Permitted-Action: true
  X-User-Telegram: deliver-courier
}

tests {
  test("status is 400", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("Page size");
  });
}
