meta {
  name: Open order is not an in-progress delivery
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/orders/deliveries/active
  body: none
  auth: none
}
headers {
  X-User-Id: c35dc8b4-f300-3285-8e2f-983ed1c791ef
  X-Permitted-Action: true
  X-User-Telegram: deliver-courier
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    const listed = res.getBody().content.some(order => order.id === bru.getVar("orderId"));
    expect(listed).to.equal(false);
  });
}
