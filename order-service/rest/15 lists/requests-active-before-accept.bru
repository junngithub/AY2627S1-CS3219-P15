meta {
  name: Open order is an active request
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/orders/requests/active
  body: none
  auth: none
}
headers {
  X-User-Id: c0e8ac0d-6089-31b0-a013-fa4f0061ad3f
  X-Permitted-Action: true
  X-User-Telegram: deliver-req
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    const match = res.getBody().content.find(order => order.id === bru.getVar("orderId"));
    expect(match.status).to.equal("CREATED");
  });
}
