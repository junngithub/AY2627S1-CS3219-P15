meta {
  name: create not permitted
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}
headers {
  X-User-Id: 11111111-1111-1111-1111-111111111111
  X-Permitted-Action: false
}

body:json {
  {
    "itemDescription": "Print notes",
    "credits": 1,
    "expiryTime": "{{acceptanceExpiry}}",
    "deliveryTime": "{{deliveryDeadline}}",
    "fromLocation": "2",
    "toLocation": "4"
  }
}

vars:pre-request {
  acceptanceExpiry: 2026-09-30T00:00:00Z
  deliveryDeadline: 2026-09-31T00:00:00Z
}

tests {
  test("status is 403", function() {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().error).to.include("not permitted");
  });
}
