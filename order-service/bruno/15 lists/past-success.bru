meta {
  name: List past requests
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/orders/requests/past
  body: none
  auth: none
}
headers {
  X-User-Id: c0e8ac0d-6089-31b0-a013-fa4f0061ad3f
  X-Permitted-Action: true
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
    const match = res.getBody().content.find(order => order.id === bru.getVar("pastOrderId"));
    expect(match.status).to.equal("CANCELLED");
    expect(match.requesterId).to.equal("c0e8ac0d-6089-31b0-a013-fa4f0061ad3f");
    const accepted = res.getBody().content.some(order => order.id === bru.getVar("orderId"));
    expect(accepted).to.equal(false);
  });
}
