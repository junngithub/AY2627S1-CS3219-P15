sequenceDiagram
    actor Requester
    participant Orders as Order service
    participant Photos as Photo store
    participant Admin as Admin Service
    participant DB as Postgres

    Requester->>Orders: POST /api/v1/orders/{orderId}/escalate
    Note over Orders: requester, COLLECTED or DELIVERED, acknowledgement window still open
    opt dispute photo attached
        Orders->>Photos: store dispute photo
    end
    Orders->>Admin: POST /api/v1/admin/conflicts
    Admin-->>Orders: accepted
    Orders->>DB: ESCALATED, dispute text, log, alert, status outbox
    Orders-->>Requester: 200 ESCALATED
