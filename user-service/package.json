{
  "name": "user-service",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --poll src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "bootstrap:admin": "node dist/bootstrap-admin.js",
    "test": "tsx --test src/**/*.test.ts",
    "test:integration:password-reset": "node --test scripts/password-reset.integration.cjs",
    "test:integration:onboarding": "node --test scripts/onboarding.integration.cjs",
    "test:integration:lifecycle": "node --test scripts/lifecycle.integration.cjs",
    "test:integration:admin-bootstrap": "node --test scripts/admin-bootstrap.integration.cjs",
    "test:integration:email": "node --test scripts/email.integration.cjs",
    "test:integration:admin-users": "node --test scripts/admin-users.integration.cjs",
    "test:integration:lockout": "node --test scripts/lockout.integration.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1153.0",
    "@prisma/client": "^5.20.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "kafkajs": "^2.2.4",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^5.20.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2"
  }
}
