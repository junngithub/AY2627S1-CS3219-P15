NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://user_service:user_service_dev@localhost:5554/user_db

# Comma-separated and matched exactly after the @ symbol.
ALLOWED_EMAIL_DOMAINS=u.nus.edu,nus.edu.sg

# Replace with a long random secret outside local development.
OTP_SECRET=change-me

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
SESSION_TTL_HOURS=24
LOGIN_MAX_ATTEMPTS=5
PASSWORD_SCRYPT_COST=16384

# Kafka (publishes the foc.user.status `UserVerified` event). In the cluster the
# Helm chart injects these; leave KAFKA_BROKERS empty locally to disable
# publishing (verification still works; events are logged, not sent).
KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_CA_CERT=
# Optional overrides (defaults shown):
# KAFKA_USER_STATUS_TOPIC=foc.user.status
# KAFKA_CLIENT_ID=user-service
