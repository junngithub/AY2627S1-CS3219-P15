NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://user_service:user_service_dev@localhost:5554/user_db

# Comma-separated and matched exactly after the @ symbol.
ALLOWED_EMAIL_DOMAINS=u.nus.edu,nus.edu.sg

# Replace with a long random secret outside local development.
OTP_SECRET=change-me

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_MINUTES=30
# The origin hosting the frontend reset-password page; no trailing path.
FRONTEND_BASE_URL=http://localhost:5173
SESSION_TTL_HOURS=24
LOGIN_MAX_ATTEMPTS=5
PASSWORD_SCRYPT_COST=16384

# development logs OTP/reset links locally; ses sends through AWS; disabled sends nothing.
# Logging is rejected outside NODE_ENV=development/test. Unset in production = disabled.
EMAIL_PROVIDER=development
SES_FROM_EMAIL=
AWS_REGION=ap-southeast-1
# Host runs can use a configured AWS SSO profile instead of the following values.
# For local Docker SES tests only, enter ALL THREE temporary AWS session values
# in the ignored .env. Never put real values in this example or commit them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Explicit environment name; production disables the load-test override.
APP_ENV=local
# Internal Telegram lookup relies on Linkerd's Order-only caller policy.
# No shared lookup token or application authentication-mode setting is needed.
# Requires a verified admin bearer token and audit reason. Default OFF.
ENABLE_TEST_VERIFICATION=false
USER_DELETION_SWEEP_INTERVAL_SECONDS=3600

# Without a bot, OTPs are logged only in NODE_ENV=development.
# Real Telegram verification requires both values; keep the token out of Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_RESEND_COOLDOWN_SECONDS=60
# Only one process may poll a bot. Set false on any additional replicas.
TELEGRAM_POLLING_ENABLED=true

# Kafka (publishes the foc.user.status `UserVerified` event). In the cluster the
# Helm chart injects these; leave KAFKA_BROKERS empty locally to disable
# publishing (verification still works; events remain queued in PostgreSQL).
KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_CA_CERT=
# Optional overrides (defaults shown):
# KAFKA_USER_STATUS_TOPIC=foc.user.status
# KAFKA_CLIENT_ID=user-service
