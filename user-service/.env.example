NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://user_service:user_service_dev@localhost:5554/user_db

# Comma-separated and matched exactly after the @ symbol.
ALLOWED_EMAIL_DOMAINS=u.nus.edu,nus.edu.sg

# Replace with a long random secret outside local development.
OTP_SECRET=change-me

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
SESSION_TTL_HOURS=24
LOGIN_MAX_ATTEMPTS=5
PASSWORD_SCRYPT_COST=16384
