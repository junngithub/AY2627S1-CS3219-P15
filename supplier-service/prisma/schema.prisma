generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SupplierStatus {
  pending
  approved
  rejected
}

enum SupplierActionType {
  created
  edited
  approved
  rejected
  pending
  deleted
}

model Supplier {
  id                  Int            @id @default(autoincrement())
  name                String
  building            String?
  floor               String?
  locationDescription String?
  latitude            Float
  longitude           Float
  startingTime        String
  closingTime         String
  status              SupplierStatus @default(pending)
  createdByUserId     String?
  createdAt           DateTime       @default(now())
  categories          Category[]     @relation("SupplierCategories")

  @@index([status])
}

// Kept after the supplier row is deleted, so a removal still names the admin.
model SupplierAction {
  id           Int                @id @default(autoincrement())
  supplierId   Int
  supplierName String
  action       SupplierActionType
  actorUserId  String
  detail       String?
  createdAt    DateTime           @default(now())

  @@index([supplierId])
  @@index([actorUserId])
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  suppliers Supplier[] @relation("SupplierCategories")
}