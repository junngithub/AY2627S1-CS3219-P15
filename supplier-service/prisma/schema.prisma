generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SupplierStatus {
  pending
  approved
  rejected
}

model Supplier {
  id                  Int            @id @default(autoincrement())
  name                String
  building            String?
  floor               String?
  locationDescription String?
  latitude            Float
  longitude           Float
  startingTime        String
  closingTime         String
  status              SupplierStatus @default(pending)
  createdAt           DateTime       @default(now())
  categories          Category[]     @relation("SupplierCategories")

  @@index([status])
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  suppliers Supplier[] @relation("SupplierCategories")
}